<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QuickLook.VideoEngineHost</AssemblyName>
    <RootNamespace>QuickLook.VideoEngineHost</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\Build\Debug\QuickLook.Plugin\QuickLook.Plugin.VideoViewer\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\Build\Release\QuickLook.Plugin\QuickLook.Plugin.VideoViewer\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
    <PackageReference Include="SharpDX.MediaFoundation" Version="4.2.0" />
    <PackageReference Include="SharpDX.XAudio2" Version="4.2.0" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- 直接编译引擎源码：子进程和进程内跑的是同一份代码，不存在两份实现跑偏 -->
  <ItemGroup>
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/VideoEngine.cs" Link="Engine/VideoEngine.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/GpuContext.cs" Link="Engine/GpuContext.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/Scaler.cs" Link="Engine/Scaler.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/ToneMapper.cs" Link="Engine/ToneMapper.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/TimeStretcher.cs" Link="Engine/TimeStretcher.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/AudioOutput.cs" Link="Engine/AudioOutput.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/IVideoEngine.cs" Link="Engine/IVideoEngine.cs" />
    <Compile Include="../QuickLook.Plugin/QuickLook.Plugin.VideoViewer/Engine/HostProtocol.cs" Link="Engine/HostProtocol.cs" />
  </ItemGroup>
</Project>
